{
  "name": "polyergon",
  "version": "0.1.3",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node --project tsconfig.server.json server.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "node bin/polyergon.js",
    "lint": "next lint",
    "test": "jest",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "chokidar": "^5.0.0",
    "next": "14.2.35",
    "node-pty": "^1.1.0",
    "react": "^18",
    "react-dom": "^18",
    "uuid": "^13.0.1",
    "ws": "^8.20.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "jest": "^30.3.0",
    "jest-environment-node": "^30.3.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^7"
  },
  "bin": {
    "polyergon": "bin/polyergon.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    ".server-dist",
    "public",
    "next.config.mjs",
    "LICENSE",
    "README.md"
  ],
  "description": "Run many Claude Code and Copilot CLI sessions side by side in one local web app, plus meeting recording with a live AI assistant.",
  "homepage": "https://polyergon.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyergon/polyergon.git"
  },
  "bugs": {
    "url": "https://github.com/polyergon/polyergon/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "copilot",
    "ai-agents",
    "terminal",
    "session-manager",
    "meetings"
  ]
}
